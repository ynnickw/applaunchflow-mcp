{
  "name": "@applaunchflow/mcp",
  "version": "0.3.0",
  "description": "MCP server for AppLaunchFlow — create App Store & Google Play screenshots with AI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ynnickw/applaunchflow-mcp"
  },
  "type": "module",
  "bin": {
    "applaunchflow-mcp": "./build/index.js",
    "applaunchflow-mcp-http": "./build/http.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod 755 build/index.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start": "node build/index.js",
    "start:http": "node build/http.js",
    "test": "npm run build && node --test build/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
